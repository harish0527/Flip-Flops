module srff_tb;
reg s,r, clk,rst;
wire Q;

srff s1 (s,r,clk,rst,Q);

initial
begin
    clk = 0;
    forever #5 clk = ~clk;
end

initial
begin
    s = 0;r=0;rst=1;
    #10 s = 0;r=0;rst=0;
    #10 s = 0;r=1;
    #10 s = 1;r=0;
    #10 s = 0;r=1;
    #10;$finish;
end
initial
$display("s=%b,r=%b,Q=%b",s,r,Q);
endmodule
